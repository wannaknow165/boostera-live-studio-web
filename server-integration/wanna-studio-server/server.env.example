PORT=8800
PUBLIC_BASE_URL=http://localhost:8800
# No paid generation by default in this example configuration.
DRY_RUN=1
# Camera link (CAM LINK), development only: 1 = a browser on this computer may act as the phone without pairing, and the program page needs no key. Leave empty on a real server.
LINK_DEV=
# Camera link: JSON array of WebRTC ICE servers, for example [{"urls":"stun:stun.example.org:3478"}]. Empty = phone and server on the same network only.
LINK_ICE_SERVERS=
